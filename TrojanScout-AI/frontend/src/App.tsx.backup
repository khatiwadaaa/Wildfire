import {useEffect,useMemo,useRef,useState} from 'react';import type {ReactNode} from 'react';
import {NavLink,Route,Routes,useLocation,useNavigate,useParams} from 'react-router-dom';
import {Activity,ArrowDownRight,ArrowUpRight,BarChart3, Bell, ChevronDown, ChevronLeft, ChevronRight, CircleHelp, ClipboardList, Database, FileBarChart, Filter, Gauge, LayoutDashboard, Menu, MoreHorizontal, Play, Plus, Search, Settings, Shield, SlidersHorizontal, Sparkles, Upload, Users, Video, X, Download, CheckCircle2, Clock3, AlertCircle, FileText, Target, TrendingUp, ArrowLeft, Crosshair, Eye, RotateCcw} from 'lucide-react';
import {Area,AreaChart,Bar,BarChart,CartesianGrid,Legend,Line,LineChart,PolarAngleAxis,PolarGrid,PolarRadiusAxis, Radar,RadarChart,ResponsiveContainer,Tooltip,XAxis,YAxis} from 'recharts';
import {mockPlayers} from './data/mockPlayers';import {playerApi,comparisonApi,videoApi} from './lib/api';import type {Player,PlayerCategory,Position} from './types';
const nav=[{label:'Overview',to:'/',icon:LayoutDashboard},{label:'Players',to:'/players',icon:Users},{label:'Video Analysis',to:'/video-analysis',icon:Video},{label:'Recruit Comparison',to:'/comparison',icon:BarChart3},{label:'Roster Simulator',to:'/roster',icon:Shield},{label:'Scouting Reports',to:'/reports',icon:FileBarChart}];
function App(){const [collapsed,setCollapsed]=useState(false);const [mobile,setMobile]=useState(false);const location=useLocation();const title=nav.find(n=>n.to===location.pathname)?.label||'Player Profile';return <div className="app-shell"><aside className={`sidebar ${collapsed?'collapsed':''} ${mobile?'mobile-open':''}`}><div className="brand"><div className="brand-mark"><Crosshair size={21}/></div>{!collapsed&&<div><div className="brand-name">TROJAN<span>SCOUT</span></div><div className="brand-sub">AI BASKETBALL INTELLIGENCE</div></div>}<button className="icon-btn sidebar-close" onClick={()=>setMobile(false)}><X size={18}/></button></div><div className="program-switch"><div className="school-badge">DS</div>{!collapsed&&<div className="school-meta"><strong>Dakota State</strong><span>Men's Basketball</span></div>}{!collapsed&&<ChevronDown size={15} className="muted"/>}</div><div className="nav-label">WORKSPACE</div><nav>{nav.map(n=><NavLink key={n.to} to={n.to} end={n.to==='/'} onClick={()=>setMobile(false)} className={({isActive})=>`nav-item ${isActive?'active':''}`}><n.icon size={18}/>{!collapsed&&<span>{n.label}</span>}{!collapsed&&n.to==='/video-analysis'&&<span className="nav-dot"/>}</NavLink>)}</nav><div className="sidebar-bottom"><div className="scout-status"><span className="status-dot"/>{!collapsed&&<><span>DEMO ENVIRONMENT</span><span className="env-tag">MOCK</span></>}</div><NavLink to="/settings" className="nav-item"><Settings size={18}/>{!collapsed&&<span>Settings</span>}</NavLink><div className="user-profile"><div className="avatar">JC</div>{!collapsed&&<div className="user-meta"><strong>Jordan Carter</strong><span>Assistant Coach</span></div>}{!collapsed&&<MoreHorizontal size={18} className="muted"/>}</div></div></aside>{mobile&&<div className="mobile-scrim" onClick={()=>setMobile(false)}/>}<main className="main-area"><header className="topbar"><div className="top-left"><button className="icon-btn mobile-menu" onClick={()=>setMobile(true)}><Menu size={20}/></button><button className="icon-btn collapse-btn" onClick={()=>setCollapsed(!collapsed)}><Menu size={19}/></button><div className="crumb">SCOUTING / <strong>{title.toUpperCase()}</strong></div></div><div className="top-actions"><div className="season-pill"><span className="live-dot"/>2025–26 SEASON</div><button className="icon-btn" aria-label="Notifications"><Bell size={18}/><i/></button><button className="help-btn"><CircleHelp size={17}/> Help</button></div></header><div className="page-wrap"><Routes><Route path="/" element={<Dashboard/>}/><Route path="/players" element={<Players/>}/><Route path="/players/:id" element={<PlayerDetail/>}/><Route path="/video-analysis" element={<VideoAnalysisPage/>}/><Route path="/comparison" element={<Comparison/>}/><Route path="/roster" element={<Roster/>}/><Route path="/reports" element={<Reports/>}/><Route path="/settings" element={<SettingsPage/>}/><Route path="*" element={<Dashboard/>}/></Routes></div></main></div>}
function PageHead({eyebrow,title,description,action}:{eyebrow:string;title:string;description:string;action?:ReactNode}){return <div className="page-head"><div><div className="eyebrow">{eyebrow}</div><h1>{title}</h1><p>{description}</p></div>{action&&<div className="head-action">{action}</div>}</div>}
function StatCard({label,value,delta,icon:Icon,sub}:{label:string;value:string;delta?:string;icon:any;sub:string}){return <div className="stat-card"><div className="stat-top"><span>{label}</span><div className="stat-icon"><Icon size={17}/></div></div><div className="stat-value">{value}</div><div className="stat-foot">{delta&&<span className="positive"><ArrowUpRight size={13}/>{delta}</span>}<span>{sub}</span></div></div>}
function Dashboard() {
  const [players, setPlayers] = useState<Player[]>([]);

  useEffect(() => {
    let active = true;

    playerApi.list()
      .then(data => {
        if (active) setPlayers(data);
      })
      .catch(error => {
        console.error("Failed to load dashboard players:", error);
      });

    return () => {
      active = false;
    };
  }, []);

  const recruits = players.filter(
    p => p.category === "Prospective Recruit"
  );